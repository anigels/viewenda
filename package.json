{
  "name": "cue-streaming-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader native",
    "typecheck": "tsc --noEmit",
